# Copy to ~/.config/ntfy-token.env and chmod 600.
# Never commit the real file — .gitignore already excludes *.env

# Publish rights on the alert topic. Used by every alerting script.
NTFY_TOKEN=tk_replace_me

# Publish-only, scoped to the command topic ONLY. Backs the one-tap action
# buttons. Least privilege on purpose: a notification on a lock screen must not
# be usable to read alert history.
NTFY_CMD_TOKEN=tk_replace_me_too
